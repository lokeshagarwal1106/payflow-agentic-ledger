# Optional: Free PayPal Developer Sandbox credentials (https://developer.paypal.com/dashboard/)
# When omitted, PayFlow runs in honest LOCAL SANDBOX REPLAY mode with zero billing and zero external calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Server port (optional)
PORT=8787

# Optional: Free local Ollama runtime URL (e.g. http://localhost:11434) — never required
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
