{
  "name": "payflow-agentic-ledger",
  "version": "1.0.0",
  "description": "Zero-cost Agentic PayPal Treasury & Payout Copilot powered by @paypal/agent-toolkit, PayPal Sandbox REST APIs, and AG Grid",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
